# Copy to `.env` to point the site at a different Supabase project.
# Both values are optional: without a .env file the defaults in src/config.js
# (the shared school project + its publishable key) are used.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
